const { 
    getPopularMovies,
    searchMovies
 } = require("../services/tmdbService");

function parsePage(value) {
    if (value === undefined) {
        return 1;
    }

    if (
        typeof value !== "string" ||
        !/^[1-9]\d*$/.test(value)
    ) {
        return null;
    }

    const page = Number(value);

    return Number.isSafeInteger(page) && page <= 500
        ? page
        : null;
}

async function getPopular(req, res, next) {
    try {
        const page = parsePage(req.query.page);

        if (page === null) {
            return res.status(400).json({
                message: "Page must be an integer between 1 and 500"
            });
        }

        const movies = await getPopularMovies(page);

        res.status(200).json(movies);
    } catch (error) {
        next(error);
    }
}

async function getSearch(req, res, next) {
    try {
        const query = req.query.query;
        const page = parsePage(req.query.page);

        if (
            typeof query !== "string" ||
            !query.trim() ||
            query.length > 100
        ) {
            return res.status(400).json({
                message: "Search query must be between 1 and 100 characters"
            });
        }

        if (page === null) {
            return res.status(400).json({
                message: "Page must be an integer between 1 and 500"
            });
        }

        const movies = await searchMovies(query.trim(), page);

        res.status(200).json(movies);
    } catch (error) {
        next(error);
    }
}

module.exports = { 
    getPopular,
    getSearch
};