const { 
    getPopularMovies,
    searchMovies
 } = require("../services/tmdbService");

async function getPopular(req, res, next) {
    try {
        const movies = await getPopularMovies();
        res.status(200).json(movies);
    } catch (error) {
        next(error);
    }
}

async function getSearch(req, res, next) {
    try {
        const query = req.query.query;

        if (
            typeof query !== "string" ||
            !query.trim() ||
            query.length > 100
        ) {
            return res.status(400).json({
                message: "Search query must be between 1 and 100 characters"
            });
        }

        const movies = await searchMovies(query.trim());

        res.status(200).json(movies);
    } catch (error) {
        next(error);
    }
}

module.exports = { 
    getPopular,
    getSearch
};